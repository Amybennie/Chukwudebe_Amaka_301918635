-- Q1/Q2 helper: room.lodge_id (foreign-key side, not auto-indexed)
CREATE INDEX
-- Q1 helper: room.room_type_id (foreign-key side, not auto-indexed)
CREATE INDEX
-- Q1 helper: tenancy.room_id (drives the NOT EXISTS overlap lookup)
CREATE INDEX
-- Q4 helper: tenancy.tenant_id (foreign-key side, not auto-indexed)
CREATE INDEX
-- Q1 helper: tenancy(start_date, end_date) for daterange overlap
CREATE INDEX
-- Q3/Q4 helper: rent_instalment.tenancy_id (foreign-key side)
CREATE INDEX
-- Q4 helper: rent_instalment(due_date) WHERE paid_at IS NULL (PARTIAL)
CREATE INDEX
-- Q3 helper: rent_instalment.paid_at (supports the FILTER split)
CREATE INDEX
-- Q5 helper: waitlist_entry.room_type_id (foreign-key side)
CREATE INDEX
-- Q6 helper: maintenance_ticket(lodge_id) WHERE resolved_at IS NOT NULL (PARTIAL)
CREATE INDEX
-- Q6 helper: maintenance_ticket.resolved_at (supports resolved_at IS NOT NULL)
